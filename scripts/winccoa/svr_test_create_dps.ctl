// svr_test_create_dps.ctl
//
// Run inside SVR_TEST (e.g. via the CTRL Manager, or para_script/PVSS00ctrl
// pointed at this file). Reads tag_list.csv (generated by gen_mock_csv.py
// from src/topology/equipment_catalog.py) and creates one DP per tag using
// the "individual DP" convention from SKILL_winccoa.md 5.1 - this matches
// the real FMCS convention 1:1 (EQP_NAME = tag, e.g. VCB_3F11A10_CURRENT),
// which is why it was picked over a per-equipment-type DPT with DPEs.
//
// Creates two flat DPTs itself on first run (FMCS_FLOAT/FMCS_BOOL, each a
// STRUCT root with one child element ".value") - same dpTypeCreate() pattern
// already proven working in FMCS_GRE200_3.21/scripts/GRE200_dpSetup.ctl.
// The settable DPE is therefore "<tag>.value", not the bare DP name - see
// svr_test_replay_mock.ctl's dpSet() call.
//
// Usage (from CTRL Manager "Execute Script" or command line):
//   WCCOActrl -proj SVR_TEST svr_test_create_dps.ctl <path to tag_list.csv>

const string FLOAT_TYPE = "FMCS_FLOAT";
const string BOOL_TYPE  = "FMCS_BOOL";

void ensureType(string dptName, int elType)
{
  if (dpTypeExists(dptName))
    return;
  dyn_dyn_string n; dyn_dyn_int t; int i = 0;
  i++; n[i] = makeDynString(dptName);          t[i] = makeDynInt(DPEL_STRUCT);
  i++; n[i] = makeDynString(dptName, "value");  t[i] = makeDynInt(DPEL_STRUCT, elType);
  if (dpTypeCreate(n, t) < 0)
    DebugN("svr_test_create_dps: dpTypeCreate FAILED for " + dptName, getLastError());
  while (!dpTypeExists(dptName))
    delay(0, 100);
}

main(string csvPath = "tag_list.csv")
{
  ensureType(FLOAT_TYPE, DPEL_FLOAT);
  ensureType(BOOL_TYPE, DPEL_BOOL);

  file f = fopen(csvPath, "r");
  if (f == 0)
  {
    DebugN("svr_test_create_dps: cannot open " + csvPath);
    return;
  }

  string header;
  fgets(header, 4096, f);
  header = strrtrim(header, "\r\n");  // CSV is CRLF; without this the last
                                       // column name never matches (e.g. "dtype\r")
  dyn_string cols = strsplit(header, ",");
  int tagCol = dynContains(cols, "tag") - 1;
  int dtypeCol = dynContains(cols, "dtype") - 1;
  if (tagCol < 0 || dtypeCol < 0)
  {
    DebugN("svr_test_create_dps: tag_list.csv missing 'tag' or 'dtype' column");
    fclose(f);
    return;
  }

  int created = 0, skipped = 0, failed = 0;
  string line;
  file outLog = fopen("created_tags.txt", "w");

  while (fgets(line, 4096, f) > 0)
  {
    line = strrtrim(line, "\r\n");
    if (line == "") continue;
    dyn_string parts = strsplit(line, ",");
    if (dynlen(parts) <= tagCol || dynlen(parts) <= dtypeCol) continue;

    string tag = parts[tagCol + 1];
    string dtype = parts[dtypeCol + 1];
    string dpt = (dtype == "BOOL") ? BOOL_TYPE : FLOAT_TYPE;

    if (dpExists(tag))
    {
      skipped++;
      continue;
    }
    if (dpCreate(tag, dpt) == 0)
    {
      created++;
      fputs(tag + "\n", outLog);
    }
    else
    {
      failed++;
      DebugN("svr_test_create_dps: dpCreate failed for " + tag);
    }
  }

  fclose(f);
  fclose(outLog);
  DebugN("svr_test_create_dps: created=" + created + " skipped(existing)=" + skipped + " failed=" + failed);
}
